        </mxCell>
        <mxCell id="15" value="1. Chọn chuyên mục 'Phúc Lợi Đoàn Viên' trên thanh điều hướng" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeWidth=1.2;strokeColor=#000000;fontSize=11;fontColor=#000000;fontFamily=Arial;" parent="1" edge="1">
