        <mxCell id="22" value="8. Chuyển hướng Kho Biểu mẫu -&gt; GET /api/templates/download/BM-01" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeWidth=1.2;strokeColor=#000000;fontSize=11;fontColor=#000000;fontFamily=Arial;" parent="1" edge="1">
