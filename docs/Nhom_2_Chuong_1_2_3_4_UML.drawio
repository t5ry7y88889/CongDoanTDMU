        <mxCell id="19" value="5. Hiển thị các thẻ chính sách (Mã số, Tiêu đề, Định mức, Đối tượng)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#000000;fontSize=11;fontColor=#000000;fontFamily=Arial;" parent="1" edge="1">
