ản kích hoạt (Active)]" style="line;strokeWidth=1;dashed=1;labelBackgroundColor=none;fillColor=none;strokeColor=#b85450;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="610" as="sourcePoint" /><mxPoint x="1050" y="610" as="targetPoint" /></mxGeometry></mxCell><mxCell id="18" value="5b: Ký mã JWT Token (Payload: { id, email, role, branchId })" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.2;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="650" as="sourcePoint" /><mxPoint x="650" y="680" as="targetPoint" /><Array as="points"><mxPoint x="690" y="650" /><mxPoint x="690" y="680" /></Array></mxGeometry></mxCell><mxCell id="19" value="6: UPDATE USERS SET LastLoginAt = GETDATE() WHERE Id = @id" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="710" as="sourcePoint" /><mxPoint x="920" y="710" as="targetPoint" /></mxGeometry></mxCell><mxCell id="20" value="7: HTTP 200 OK { token, refreshToken, user: { id, fullName, role } }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="750" as="sourcePoint" /><mxPoint x="380" y="750" as="targetPoint" /></mxGeometry></mxCell><mxCell id="21" value="8: Lưu Token (LocalStorage/Cookie), điều hướng Dashboard theo Role" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="790" as="sourcePoint" /><mxPoint x="140" y="790" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>