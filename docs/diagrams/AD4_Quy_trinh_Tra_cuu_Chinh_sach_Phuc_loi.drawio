        <!-- Tiêu đề sơ đồ -->
        <mxCell id="2" value="SƠ ĐỒ HOẠT ĐỘNG: QUY TRÌNH TRA CỨU &amp; TIẾP CẬN CHÍNH SÁCH CHĂM LO PHÚC LỢI" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=15;fontColor=#000000;fontFamily=Arial;" parent="1" vertex="1">
