        <!-- Step 1: Truy cap chuyen muc -->
        <mxCell id="4" value="Đoàn viên truy cập Cổng thông tin Công đoàn TDMU&#10;Chọn chuyên mục 'Phúc Lợi Đoàn Viên' trên thanh điều hướng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontStyle=0;fontSize=11;fontColor=#000000;fontFamily=Arial;" parent="1" vertex="1">
