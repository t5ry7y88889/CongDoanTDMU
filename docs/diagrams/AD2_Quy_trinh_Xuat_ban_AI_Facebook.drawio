<mxfile host="app.diagrams.net" modified="2026-09-28T03:30:00.000Z" agent="Antigravity Agent" version="24.0.0" type="device"><diagram id="act_ai_publish" name="AD2: Hoạt động Biên tập &amp; Xuất bản AI"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1150" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="SƠ ĐỒ HOẠT ĐỘNG (ACTIVITY DIAGRAM): SOẠN THẢO, TRỢ LÝ AI HỖ TRỢ &amp; XUẤT BẢN ĐA KÊNH" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=16;fontColor=#1a365d;" parent="1" vertex="1"><mxGeometry x="150" y="20" width="900" height="40" as="geometry" /></mxCell><mxCell id="3" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2b2b2b;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="535" y="80" width="30" height="30" as="geometry" /></mxCell><mxCell id="4" value="Biên tập viên mở màn hình soạn thảo bài viết&lt;br&gt;Nhập tiêu đề sơ bộ, chọn danh mục và nhập nội dung thô" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;fontSize=11;" parent="1" vertex="1"><mxGeometry x="400" y="140" width="300" height="50" as="geometry" /></mxCell><mxCell id="5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" parent="1" edge="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="6" value="Sử dụng Trợ lý&lt;br&gt;AI Copilot?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" parent="1" vertex="1"><mxGeometry x="480" y="220" width="140" height="60" as="geometry" /></mxCell><mxCell id="7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" parent="1" edge="1" source="4" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="8" value="Chọn chức năng: Tóm tắt bài / Tối ưu tiêu đề SEO /&lt;br&gt;Sửa văn phong chuẩn báo chí Công đoàn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=0;fontSize=11;" parent="1" vertex="1"><mxGeometry x="680" y="225" width="260" height="50" as="geometry" /></mxCell><mxCell id="9" value="[Có]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" parent="1" edge="1" source="6" target="8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="10" value="Hệ thống gửi prompt &amp; nội dung thô&lt;br&gt;đến Google Gemini Pro API" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=0;fontSize=11;" parent="1" vertex="1"><mxGeometry x="680" y="305" width="260" height="50" as="geometry" /></mxCell><mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" parent="1" edge="1" source="8" target="10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="12" value="Nhận kết quả gợi ý từ Gemini AI&lt;br&gt;Biên tập viên xem trước, tinh chỉnh và áp dụng vào bài" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=0;fontSize=11;" parent="1" vertex="1"><mxGeometry x="680" y="385" width="260" height="50" as="geometry" /></mxCell><mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" parent="1" edge="1" source="10" target="12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="14" value="Biên tập viên tự hoàn thiện nội dung thủ công" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;fontSize=11;" parent="1" vertex="1"><mxGeometry x="330" y="305" width="210" height="50" as="geometry" /></mxCell><mxCell id="15" value="[Không]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" parent="1" edge="1" source="6" target="14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="16" value="Tải lên hình ảnh đại diện (Banner) và tệp đính kèm bài viết" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;fontSize=11;" parent="1" vertex="1"><mxGeometry x="400" y="470" width="300" height="50" as="geometry" /></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="355" as="sourcePoint" /><mxPoint x="475" y="470" as="targetPoint" /><Array as="points"><mxPoint x="435" y="430" /><mxPoint x="475" y="430" /></Array></mxGeometry></mxCell><mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="435" as="sourcePoint" /><mxPoint x="625" y="470" as="targetPoint" /><Array as="points"><mxPoint x="810" y="445" /><mxPoint x="625" y="445" /></Array></mxGeometry></mxCell><mxCell id="19" value="Lựa chọn chế độ xuất bản?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" parent="1" vertex="1"><mxGeometry x="450" y="550" width="200" height="60" as="geometry"