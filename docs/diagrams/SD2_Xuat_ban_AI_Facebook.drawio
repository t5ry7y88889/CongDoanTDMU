<mxfile host="app.diagrams.net" modified="2026-09-28T03:30:00.000Z" agent="Antigravity Agent" version="24.0.0" type="device"><diagram id="seq_ai_facebook" name="SD2: Xuất bản bài viết AI &amp; Facebook"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="1050" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="SƠ ĐỒ TUẦN TỰ (SEQUENCE DIAGRAM): SOẠN THẢO, TRỢ LÝ AI HỖ TRỢ &amp; XUẤT BẢN ĐA KÊNH FACEBOOK" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=16;fontColor=#1a365d;" parent="1" vertex="1"><mxGeometry x="200" y="20" width="950" height="40" as="geometry" /></mxCell><mxCell id="3" value="Biên tập viên&lt;br&gt;(Editor)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="90" y="80" width="60" height="80" as="geometry" /></mxCell><mxCell id="4" value="" style="dashed=1;strokeWidth=1;strokeColor=#999999;endArrow=none;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="170" as="sourcePoint" /><mxPoint x="120" y="980" as="targetPoint" /></mxGeometry></mxCell><mxCell id="5" value="Frontend Web UI&lt;br&gt;(React CMS)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="260" y="110" width="140" height="870" as="geometry" /></mxCell><mxCell id="6" value="Backend API&lt;br&gt;(Node.js Express)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="500" y="110" width="140" height="870" as="geometry" /></mxCell><mxCell id="7" value="Database Server&lt;br&gt;(MSSQL 2022)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="730" y="110" width="140" height="870" as="geometry" /></mxCell><mxCell id="8" value="Trợ lý AI API&lt;br&gt;(Google Gemini Pro)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="955" y="110" width="150" height="870" as="geometry" /></mxCell><mxCell id="9" value="Meta Facebook API&lt;br&gt;(Graph API v19.0)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1165" y="110" width="150" height="870" as="geometry" /></mxCell><mxCell id="10" value="1: Nhập nội dung thô, chuyên mục &amp; tiêu đề sơ bộ" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="190" as="sourcePoint" /><mxPoint x="330" y="190" as="targetPoint" /></mxGeometry></mxCell><mxCell id="11" value="2: Nhấn 'AI Copilot: Tóm tắt, gợi ý tiêu đề &amp; tối ưu SEO'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="230" as="sourcePoint" /><mxPoint x="330" y="230" as="targetPoint" /></mxGeometry></mxCell><mxCell id="12" value="3: POST /api/ai/generate { rawContent, mode: 'seo_summary' }" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="270" as="sourcePoint" /><mxPoint x="570" y="270" as="targetPoint" /></mxGeometry></mxCell><mxCell id="13" value="4: Gọi Gemini API (generateContent với System Prompt chuẩn)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="310" as="sourcePoint" /><mxPoint x="1030" y="310" as="targetPoint" /></mxGeometry></mxCell><mxCell id="14" value="5: Trả về JSON { suggestedTitle, summary, keywords, seoScore }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="360" as="sourcePoint" /><mxPoint x="570" y="360" as="targetPoint" /></mxGeometry></mxCell><mxCell id="15" value="6: HTTP 200 OK { aiResult: { title, summary, tags } }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="400" as="sourcePoint" /><mxPoint x="330" y="400" as="targetPoint" /></mxGeometry></mxCell><mxCell id="16" value="7: Hiển thị giao diện AI Copilot cho BTV duyệt &amp; chèn vào bài" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="440" as="sourcePoint" /><mxPoint x="120" y="440" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17" value="8: Thêm ảnh Banner, chọn kênh [Website, Fanpage], nhấn 'Xuất bản'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="490" as="sourcePoint" /><mxPoint x="330" y="490" as="targetPoint" /></mxGeometry></mxCell><mxCell id="18" value="9: POST /api/articles/publish { articleData, channels: ['web', 'fb'] }" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="540" as="sourcePoint" /><mxPoint x="570" y="540" as="targetPoint" /></mxGeometry></mxCell><mxCell id="19" value="10: INSERT/UPDATE ARTICLES (Status='Published', PublishedAt=NOW)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="590" as="sourcePoint" /><mxPoint x="800" y="590" as="targetPoint" /></mxGeometry></mxCell><mxCell id="20" value="11: Xác nhận lưu bài viết thành công (ArticleId)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="630" as="sourcePoint" /><mxPoint x="570" y="630" as="targetPoint" /></mxGeometry></mxCell><mxCell id="21" value="12: INSERT ARTICLE_AUDITS (ArticleId, Action='PUBLISH', ActorId)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="670" as="sourcePoint" /><mxPoint x="800" y="670" as="targetPoint" /></mxGeometry></mxCell><mxCell id="22" value="13: POST https://graph.facebook.com/v19.0/{page_id}/feed (msg, link, photo)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="720" as="sourcePoint" /><mxPoint x="1240" y="720" as="targetPoint" /></mxGeometry></mxCell><mxCell id="23" value="14: Trả về Facebook Post ID { id: 'fb_post_987654321' }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="770" as="sourcePoint" /><mxPoint x="570" y="770" as="targetPoint" /></mxGeometry></mxCell><mxCell id="24" value="15: UPDATE ARTICLES SET FacebookPostId = 'fb_post_987654321'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="820" as="sourcePoint" /><mxPoint x="800" y="820" as="targetPoint" /></mxGeometry></mxCell><mxCell id="25" value="16: Xác nhận đồng bộ mạng xã hội hoàn tất" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="860" as="sourcePoint" /><mxPoint x="570" y="860" as="targetPoint" /></mxGeometry></mxCell><mxCell id="26" value="17: HTTP 200 OK { message: 'Xuất bản đa kênh thành công', fbPostId }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="900" as="sourcePoint" /><mxPoint x="330" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="27" value="18: Hiển thị thông báo thành công &amp; xem bài viết thực tế trên Portal" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="940" as="sourcePoint" /><mxPoint x="120" y="940" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>