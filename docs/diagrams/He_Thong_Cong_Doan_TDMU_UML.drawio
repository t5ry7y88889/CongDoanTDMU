(BranchId, SelfScore, Status='Pending')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="330" as="sourcePoint" /><mxPoint x="910" y="330" as="targetPoint" /></mxGeometry></mxCell><mxCell id="14" value="4: Trả về ReportId và xác nhận đã lưu" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="370" as="sourcePoint" /><mxPoint x="640" y="370" as="targetPoint" /></mxGeometry></mxCell><mxCell id="15" value="5: HTTP 201 Created { message: 'Đã nộp báo cáo, đang chờ thẩm định' }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="410" as="sourcePoint" /><mxPoint x="360" y="410" as="targetPoint" /></mxGeometry></mxCell><mxCell id="16" value="6: Hiển thị trạng thái 'Chờ duyệt' cho Tổ công đoàn" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="450" as="sourcePoint" /><mxPoint x="120" y="450" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17" value="7: Mở danh sách báo cáo thi đua 16 Tổ, chọn báo cáo cần thẩm định" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="510" as="sourcePoint" /><mxPoint x="360" y="510" as="targetPoint" /></mxGeometry></mxCell><mxCell id="18" value="8: GET /api/competition/reports/{reportId}" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="550" as="sourcePoint" /><mxPoint x="640" y="550" as="targetPoint" /></mxGeometry></mxCell><mxCell id="19" value="9: SELECT * FROM MONTHLY_REPORTS JOIN UNION_BRANCHES WHERE Id = @id" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="590" as="sourcePoint" /><mxPoint x="910" y="590" as="targetPoint" /></mxGeometry></mxCell><mxCell id="20" value="10: Trả về chi tiết báo cáo và đường dẫn tệp minh chứng" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="630" as="sourcePoint" /><mxPoint x="640" y="630" as="targetPoint" /></mxGeometry></mxCell><mxCell id="21" value="11: Hiển thị giao diện đối soát minh chứng và khung chấm điểm" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="670" as="sourcePoint" /><mxPoint x="360" y="670" as="targetPoint" /></mxGeometry></mxCell><mxCell id="22" value="11.1: Ban Thi đua kiểm tra minh chứng" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="700" as="sourcePoint" /><mxPoint x="1140" y="700" as="targetPoint" /></mxGeometry></mxCell><mxCell id="23" value="12: Nhập điểm chính thức, nhận xét và nhấn 'Phê duyệt &amp; Chấm điểm'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="740" as="sourcePoint" /><mxPoint x="360" y="740" as="targetPoint" /></mxGeometry></mxCell><mxCell id="24" value="13: PUT /api/competition/reports/{id}/evaluate { officialScore, status='Approved' }" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="780" as="sourcePoint" /><mxPoint x="640" y="780" as="targetPoint" /></mxGeometry></mxCell><mxCell id="25" value="14: UPDATE MONTHLY_REPORTS SET OfficialScore = @score, Status = 'Approved'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="820" as="sourcePoint" /><mxPoint x="910" y="820" as="targetPoint" /></mxGeometry></mxCell><mxCell id="26" value="14.1: Tự động tính tổng điểm tích lũy &amp; xếp thứ hạng từ 1 đến 16 của 16 Tổ" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.2;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="860" as="sourcePoint" /><mxPoint x="640" y="890" as="targetPoint" /><Array as="points"><mxPoint x="680" y="860" /><mxPoint x="680" y="890" /></Array></mxGeometry></mxCell><mxCell id="27" value="15: UPDATE UNION_BRANCHES SET TotalScore = @total, CurrentRank = @rank" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="910" as="sourcePoint" /><mxPoint x="910" y="910" as="targetPoint" /></mxGeometry></mxCell><mxCell id="28" value="16: HTTP 200 OK &amp; Cập nhật Bảng xếp hạng thi đua công khai (Leaderboard)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="950" as="sourcePoint" /><mxPoint x=