<mxfile host="app.diagrams.net" modified="2026-09-28T03:30:00.000Z" agent="Antigravity Agent" version="24.0.0" type="device"><diagram id="seq_competition" name="SD3: Báo cáo &amp; Thi đua 16 Tổ"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1020" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="SƠ ĐỒ TUẦN TỰ (SEQUENCE DIAGRAM): NỘP BÁO CÁO &amp; XẾP HẠNG THI ĐUA 16 TỔ CÔNG ĐOÀN" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=16;fontColor=#1a365d;" parent="1" vertex="1"><mxGeometry x="150" y="20" width="950" height="40" as="geometry" /></mxCell><mxCell id="3" value="Đại diện 16 Tổ&lt;br&gt;(Contributor)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="90" y="80" width="60" height="80" as="geometry" /></mxCell><mxCell id="4" value="" style="dashed=1;strokeWidth=1;strokeColor=#999999;endArrow=none;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="170" as="sourcePoint" /><mxPoint x="120" y="950" as="targetPoint" /></mxGeometry></mxCell><mxCell id="5" value="Frontend Web UI&lt;br&gt;(React SPA)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="290" y="110" width="140" height="840" as="geometry" /></mxCell><mxCell id="6" value="Backend API&lt;br&gt;(Node.js Express)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="570" y="110" width="140" height="840" as="geometry" /></mxCell><mxCell id="7" value="Database Server&lt;br&gt;(MSSQL 2022)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="840" y="110" width="140" height="840" as="geometry" /></mxCell><mxCell id="8" value="Ban Thi đua&lt;br&gt;(Admin/Editor)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1110" y="80" width="60" height="80" as="geometry" /></mxCell><mxCell id="9" value="" style="dashed=1;strokeWidth=1;strokeColor=#999999;endArrow=none;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="170" as="sourcePoint" /><mxPoint x="1140" y="950" as="targetPoint" /></mxGeometry></mxCell><mxCell id="10" value="1: Nhập số liệu hoạt động, tự chấm điểm 5 tiêu chí &amp; đính kèm file minh chứng" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="190" as="sourcePoint" /><mxPoint x="360" y="190" as="targetPoint" /></mxGeometry></mxCell><mxCell id="11" value="2: POST /api/competition/reports (FormData: branchId, month, score, files)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="230" as="sourcePoint" /><mxPoint x="640" y="230" as="targetPoint" /></mxGeometry></mxCell><mxCell id="12" value="2.1: Lưu trữ tệp minh chứng (PDF/Ảnh) vào thư mục bảo mật" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.2;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="270" as="sourcePoint" /><mxPoint x="640" y="300" as="targetPoint" /><Array as="points"><mxPoint x="680" y="270" /><mxPoint x="680" y="300" /></Array></mxGeometry></mxCell><mxCell id="13" value="3: INSERT INTO MONTHLY_REPORTS (BranchId, SelfScore, Status='Pending')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="330" as="sourcePoint" /><mxPoint x="910" y="330" as="targetPoint" /></mxGeometry></mxCell><mxCell id="14" value="4: Trả về ReportId và xác nhận đã lưu" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="370" as="sourcePoint" /><mxPoint x="640" y="370" as="targetPoint" /></mxGeometry></mxCell><mxCell id="15" value="5: HTTP 201 Created { message: 'Đã nộp báo cáo, đang chờ thẩm định' }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="410" as="sourcePoint" /><mxPoint x="360" y="410" as="targetPoint" /></mxGeometry></mxCell><mxCell id="16" value="6: Hiển thị trạng thái 'Chờ duyệt' cho Tổ công đoàn" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="450" as="sourcePoint" /><mxPoint x="120" y="450" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17" value="7: Mở danh sách báo cáo thi đua 16 Tổ, chọn báo cáo cần thẩm định" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="510" as="sourcePoint" /><mxPoint x="360" y="510" as="targetPoint" /></mxGeometry></mxCell><mxCell id="18" value="8: GET /api/competition/reports/{reportId}" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="550" as="sourcePoint" /><mxPoint x="640" y="550" as="targetPoint" /></mxGeometry></mxCell><mxCell id="19" value="9: SELECT * FROM MONTHLY_REPORTS JOIN UNION_BRANCHES WHERE Id = @id" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="590" as="sourcePoint" /><mxPoint x="910" y="590" as="targetPoint" /></mxGeometry></mxCell><mxCell id="20" value="10: Trả về chi tiết báo cáo và đường dẫn tệp minh chứng" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="630" as="sourcePoint" /><mxPoint x="640" y="630" as="targetPoint" /></mxGeometry></mxCell><mxCell id="21" value="11: Hiển thị giao diện đối soát minh chứng và khung chấm điểm" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="670" as="sourcePoint" /><mxPoint x="360" y="670" as="targetPoint" /></mxGeometry></mxCell><mxCell id="22" value="11.1: Ban Thi đua kiểm tra minh chứng" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="700" as="sourcePoint" /><mxPoint x="1140" y="700" as="targetPoint" /></mxGeometry></mxCell><mxCell id="23" value="12: Nhập điểm chính thức, nhận xét và nhấn 'Phê duyệt &amp; Chấm điểm'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="740" as="sourcePoint" /><mxPoint x="360" y="740" as="targetPoint" /></mxGeometry></mxCell><mxCell id="24" value="13: PUT /api/competition/reports/{id}/evaluate { officialScore, status='Approved' }" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="780" as="sourcePoint" /><mxPoint x="640" y="780" as="targetPoint" /></mxGeometry></mxCell><mxCell id="25" value="14: UPDATE MONTHLY_REPORTS SET OfficialScore = @score, Status = 'Approved'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="820" as="sourcePoint" /><mxPoint x="910" y="820" as="targetPoint" /></mxGeometry></mxCell><mxCell id="26" value="14.1: Tự động tính tổng điểm tích lũy &amp; xếp thứ hạng từ 1 đến 16 của 16 Tổ" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.2;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="860" as="sourcePoint" /><mxPoint x="640" y="890" as="targetPoint" /><Array as="points"><mxPoint x="680" y="860" /><mxPoint x="680" y="890" /></Array></mxGeometry></mxCell><mxCell id="27" value="15: UPDATE UNION_BRANCHES SET TotalScore = @total, CurrentRank = @rank" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#0052cc;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="910" as="sourcePoint" /><mxPoint x="910" y="910" as="targetPoint" /></mxGeometry></mxCell><mxCell id="28" value="16: HTTP 200 OK &amp; Cập nhật Bảng xếp hạng thi đua công khai (Leaderboard)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="950" as="sourcePoint" /><mxPoint x="360" y="950" as="targetPoint" /></mxGeometry></mxCell><mxCell id="29" value="17: Hiển thị Bảng xếp hạng 16 Tổ công đoàn trực quan" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=1.2;strokeColor=#555555;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="980" as="sourcePoint" /><mxPoint x="1140" y="980" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>