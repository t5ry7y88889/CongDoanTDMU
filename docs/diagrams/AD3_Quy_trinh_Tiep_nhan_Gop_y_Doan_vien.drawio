        <!-- Tiêu đề sơ đồ -->
        <mxCell id="2" value="SƠ ĐỒ HOẠT ĐỘNG: TIẾP NHẬN, XỬ LÝ &amp; PHẢN HỒI Ý KIẾN NGUYỆN VỌNG ĐOÀN VIÊN" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=15;fontColor=#000000;fontFamily=Arial;" parent="1" vertex="1">
