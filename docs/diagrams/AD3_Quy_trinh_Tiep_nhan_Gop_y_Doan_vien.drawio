  <diagram id="ad3_feedback" name="AD3 - Tiếp nhận &amp; Phản hồi góp ý">
    <mxGraphModel dx="1100" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1080" background="#ffffff" math="0" shadow="0">
      <root>
