        <!-- Step 1: Truy cập form -->
        <mxCell id="4" value="Đoàn viên truy cập trang Hòm thư góp ý trên Cổng thông tin&#10;Lựa chọn chủ đề phản ánh (Chế độ, Phúc lợi, Giảng dạy, Khác)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontStyle=0;fontSize=11;fontColor=#000000;fontFamily=Arial;" parent="1" vertex="1">
