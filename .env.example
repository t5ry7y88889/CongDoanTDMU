APP_NAME=Website_CongDoan_TDMU
PORT=3000

# ============================================================
# Microsoft SQL Server 2019/2022 (Azure SQL supported too)
# ------------------------------------------------------------
# DB_HOST works on BOTH platforms:
#   - macOS / Linux: 127.0.0.1 or localhost
#   - Windows       : 127.0.0.1 or localhost (or \\SERVERNAME\INSTANCE)
#
# If you run SQL Server without a named instance, use port 1433.
# If you have NO SQL Server installed, LEAVE these as the defaults:
# the app will automatically run in JSON fallback mode (server/database.json).
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=1433
# Windows named instance example (only used for logging):
# DB_SERVER=RTX-ON\\MSSQLVESE
DB_SERVER=localhost
DB_DATABASE=TDMU_TradeUnion_DB
DB_USER=sa
DB_PASSWORD=YourStrongPassword@2026

# ============================================================
# AI Studio API Keys (Optional - app falls back to local NLP)
# ============================================================
GEMINI_API_KEY=
GROQ_API_KEY=