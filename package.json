{
  "name": "tdmu-congdoan-web",
  "version": "1.0.0",
  "description": "Website Truyền Thông Công Đoàn TDMU Tích Hợp AI Hỗ Trợ Tạo Và Đăng Tải Nội Dung",
  "main": "server/server.js",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "setup": "npm install && npm --prefix frontend install && npm --prefix frontend-admin install",
    "dev": "node scripts/serve-dev.js",
    "dev:server": "node server/server.js",
    "start": "node server/server.js",
    "build": "npm --prefix frontend run build",
    "build:admin": "npm --prefix frontend-admin run build",
    "lint": "npm --prefix frontend run lint",
    "test": "npm run test:server",
    "test:server": "NODE_ENV=test vitest run",
    "db:up": "node scripts/compose.mjs up",
    "db:down": "node scripts/compose.mjs down",
    "db:init": "node server/scripts/init-db.js",
    "db:reset": "node server/scripts/init-db.js --drop"
  },
  "keywords": [
    "tdmu",
    "cong-doan",
    "ai",
    "cms"
  ],
  "author": "Nhóm Đồ Án Cơ Sở Ngành TDMU",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.17.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mammoth": "^1.12.3",
    "mssql": "^12.7.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
}
